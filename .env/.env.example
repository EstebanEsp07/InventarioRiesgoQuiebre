# Copia este archivo a .env:  cp .env.example .env
# NUNCA subas .env al repositorio.

COMPOSE_PROJECT_NAME=inventario-quiebre

# --- PostgreSQL ---
POSTGRES_DB=inventario
POSTGRES_USER=inventario_app
POSTGRES_PASSWORD=inventario_dev_2026
POSTGRES_PORT=5432

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=inventario
RABBITMQ_DEFAULT_PASS=inventario_dev_2026
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# --- Backend (Spring Boot, monolito modular) ---
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=dev-secret-only-for-local-development-0123456789
# Umbrales del motor de recomendaciones
RIESGO_QUIEBRE_UMBRAL_DIAS=3
RECOMENDACION_EXPIRA_HORAS=24

# --- Pronóstico (tolerancia a fallos) ---
FORECAST_PORT=8000
FORECAST_URL=http://forecast:8000
FORECAST_TIMEOUT_MS=2000
# Ventana en días para el fallback de promedio móvil si el pronóstico cae
FORECAST_FALLBACK_WINDOW_DAYS=14

# --- Sistema de compras existente (mock local con WireMock) ---
PURCHASING_PORT=9090
PURCHASING_BASE_URL=http://purchasing-mock:8080
PURCHASING_API_KEY=dev-purchasing-key

# --- Frontend (React + Vite) ---
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8080/api
